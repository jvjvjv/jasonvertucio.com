{
    "private": true,
    "type": "module",
    "scripts": {
        "serve": "npm run dev",
        "dev": "concurrently --kill-others-on-fail --names vite,proxy,laravel \"npm run dev:vite\" \"npm run https-proxy\" \"php artisan serve --host=127.0.0.1 --port=8001\"",
        "dev:vite": "vite --host=localhost --port=5173 --strictPort",
        "https-proxy": "local-ssl-proxy --source 8000 --target 8001 --cert .certs/localhost.pem --key .certs/localhost-key.pem",
        "build": "vite build",
        "prod": "vite build",
        "push": "git checkout master && git merge develop --no-ff -m \"Merge branch 'develop'\" && git push && git checkout develop",
        "pull": "git pull && composer install && npm ci && npm run build && sudo php artisan optimize:clear"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@fortawesome/fontawesome-free": "^7.1.0",
        "@inertiajs/react": "^2.3.18",
        "@mui/icons-material": "^7.3.9",
        "@mui/material": "^7.3.9",
        "@mui/x-date-pickers": "^8.27.2",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.2.0",
        "angular-expressions": "^1.5.1",
        "dayjs": "^1.11.20",
        "docxtemplater": "^3.67.6",
        "file-saver": "^2.0.5",
        "marked": "^17.0.3",
        "pizzip": "^3.2.0",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "typescript": "^5.9.3"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.1.18",
        "autoprefixer": "^10.4.23",
        "concurrently": "^9.2.1",
        "laravel-vite-plugin": "^2.1.0",
        "local-ssl-proxy": "^2.0.5",
        "nprogress": "^0.2.0",
        "postcss": "^8.5.6",
        "tailwindcss": "^4.1.18",
        "vite": "^7.3.1",
        "vite-plugin-static-copy": "^3.1.5"
    }
}