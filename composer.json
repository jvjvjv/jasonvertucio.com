{
  "name": "jvjvjv/jasonvertucio.com",
  "type": "project",
  "description": "Jason Vertucio website and blog",
  "keywords": [
    "framework",
    "laravel",
    "canvas",
    "blog",
    "portfolio site"
  ],
  "license": "proprietary",
  "authors": [
    {
      "name": "Jason Vertucio",
      "email": "me@jasonvertucio.com"
    }
  ],
  "support": {
    "issues": "https://github.com/jvjvjv/jasonvertucio.com/issues",
    "source": "https://github.com/jvjvjv/jasonvertucio.com"
  },
  "require": {
    "php": "^8.4.0",
    "anthropic-ai/sdk": "^0.25.0",
    "austintoddj/canvas": "^6.0.55",
    "bspdx/keystone": "^0.9.0",
    "fakerphp/faker": "^1.24.1",
    "google-gemini-php/client": "^2.7",
    "guzzlehttp/guzzle": "^7.10.0",
    "inertiajs/inertia-laravel": "^2.0",
    "jvjvjv/code-talker": "^0",
    "laravel/fortify": "^1.36.1",
    "laravel/framework": "^12.54.1",
    "laravel/tinker": "^2.11.1",
    "laravel/ui": "^4.6.2",
    "openai-php/client": "^0.19.2",
    "symfony/dom-crawler": "^8.0",
    "twilio/sdk": "^6.44.4"
  },
  "require-dev": {
    "filp/whoops": "^2.18.4",
    "laravel/boost": "^2.3.1",
    "laravel/pint": "^1.29",
    "mockery/mockery": "^1.6.12",
    "phpunit/phpunit": "^10.5.63"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    },
    "classmap": [
      "database/seeders",
      "database/factories"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi"
    ],
    "test": [
      "@php artisan config:clear --ansi",
      "@php vendor/bin/phpunit --columns max --testdox --color=always"
    ],
    "format": "pint",
    "format:test": "pint --test"
  }
}