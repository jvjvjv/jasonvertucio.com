{
    "name": "jvjvjv/canvasblog",
    "type": "project",
    "description": "Jason Vertucio website and blog",
    "keywords": [
        "framework",
        "laravel",
        "canvas",
        "blog",
        "portfolio site"
    ],
    "license": "proprietary",
    "require": {
        "php": "^8.2.0",
        "austintoddj/canvas": "^6.0.55",
        "bspdx/keystone": "^0.6.0",
        "fakerphp/faker": "^1.24",
        "guzzlehttp/guzzle": "^7.10.0",
        "laravel/fortify": "^1.33",
        "laravel/framework": "^12.48.1",
        "laravel/tinker": "^2.11",
        "laravel/ui": "^4.6.1",
        "twilio/sdk": "^6.44.4"
    },
    "require-dev": {
        "filp/whoops": "^2.18.4",
        "laravel/boost": "^2.0",
        "mockery/mockery": "^1.6.12",
        "phpunit/phpunit": "^10.5.60"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "classmap": [
            "database/seeders",
            "database/factories"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ]
    }
}