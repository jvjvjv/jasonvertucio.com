# ====================== Application =======================
APP_NAME="Jason Vertucio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL="https://www.jasonvertucio.com"

# ======================== Logging =========================
LOG_CHANNEL=stack
LOG_SLACK_WEBHOOK_URL=

# ======================== Database ========================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jasonvertucio
DB_USERNAME=jasonvertucio
DB_PASSWORD=jasonvertucio_password

# ====== Cache, session, queue and broadcast drivers =======
BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ========================= Redis ==========================
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ========================== Mail ==========================
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="me@jasonvertucio.com"
MAIL_FROM_NAME="Jason Vertucio"

# ========================== AWS ===========================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

# ========================= Pusher =========================
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ========================= Resume =========================
RESUME_DRIVER=database

# ===================== Blog (Canvas) ======================
CANVAS_PATH=admin/blog/canvas

# ======================== Comments ========================
COMMENT_NOTIFICATION_EMAIL=me@jasonvertucio.com
COMMENT_OWNER_EMAIL=me@jasonvertucio.com
COMMENT_RATE_LIMIT_PER_MINUTE=5

# ================ Jellyfin media tracking =================
JELLYFIN_WEBHOOK_SECRET=

# ======================= CodeTalker =======================

# External MCP server (web/HTTP transport only, Sanctum-protected)
CODE_TALKER_MCP_ENABLED=false
CODE_TALKER_MCP_WEB_ENABLED=true
CODE_TALKER_MCP_LOCAL_ENABLED=false
# Domains an MCP-connected model (no AiSystem/web_tool_policy of its own) may
# send a caller-supplied Authorization/Cookie header to via http-request's
# allow_credential_headers. Add a domain here only when you deliberately want
# that.
CODE_TALKER_MCP_ALLOWED_DOMAINS=

# Streaming, raw exchange logging and web_fetcher tool caps
CODE_TALKER_MAX_STREAM_SECONDS=900
CODE_TALKER_RAW_EXCHANGES_ENABLED=false
CODE_TALKER_RAW_EXCHANGES_RETENTION_DAYS=1
CODE_TALKER_MAX_BODY_LENGTH=768000
CODE_TALKER_MAX_CONTENT_LENGTH=20000

# Web search tool provider credentials
BRAVE_SEARCH_API_KEY=
BING_SEARCH_API_KEY=
BING_SEARCH_ENDPOINT="https://api.bing.microsoft.com/v7.0/search"
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Sign in with bspdx.com (the only sign-in method). See .claude/context/auth.md.
BSPDX_LOGIN_ENABLED=false
BSPDX_BASE_URL=https://bspdx.com
BSPDX_CLIENT_ID=
BSPDX_CLIENT_SECRET=
BSPDX_REDIRECT_URI=
BSPDX_SCOPES=userinfo
