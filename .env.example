APP_NAME="Jason Vertucio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://jasonvertucio.com

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel_jasonvertucio_database_name
DB_USERNAME=db_username
DB_PASSWORD=db_password

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

WINK_DB_CONNECTION=mysql

ANTHROPIC_API_KEY="anthropic API key"

# CodeTalker external MCP server (web/HTTP transport only, Sanctum-protected)
CODE_TALKER_MCP_ENABLED=false
CODE_TALKER_MCP_WEB_ENABLED=true
CODE_TALKER_MCP_LOCAL_ENABLED=false
# Comma-separated hostnames the MCP server's web_fetcher tool may access when
# there is no conversation/AiSystem to carry its own policy.
CODE_TALKER_MCP_ALLOWED_DOMAINS=

# CodeTalker web_fetcher tool caps (fetch-web-page and http-request)
CODE_TALKER_MAX_BODY_LENGTH=150000
CODE_TALKER_MAX_CONTENT_LENGTH=20000

# CodeTalker web search tool provider credentials
BRAVE_SEARCH_API_KEY=
BING_SEARCH_API_KEY=
BING_SEARCH_ENDPOINT="https://api.bing.microsoft.com/v7.0/search"
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
